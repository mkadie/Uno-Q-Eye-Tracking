#!/usr/bin/env python3
"""Rim distance against the marker board, in the SAME frames.

The board is the ruler, not the product (CLAUDE.md). Wearing it against the
forehead with the round glasses on gives ground truth and the rim estimate
simultaneously, which beats a tape measure twice over: no parallax in reading
it, and every frame is a paired sample rather than one number per stance.

Two numbers come out, and the second is the one that matters:

  BIAS  board_mm - rim_mm averaged. A constant offset is expected and fine --
        the board sits on the forehead, the rims at the eyes, so the two
        planes are genuinely a couple of centimetres apart. It is anatomy
        plus any residual radius error, and it subtracts out.
  JITTER  the standard deviation of that difference. This one does NOT
        subtract out. It is the real precision of the rim estimator and it is
        what decides whether the rims can replace the board.

Usage:  bin/boardrim [frames] [--no-board]   (--no-board for the removed run)
"""
import sys, os, math, time
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import numpy as np, cv2
from spike import camera, config, intrinsics as I
from spike import rig_geometry
from spike.marker_board import MarkerBoard
from spike.frame_fiducial import (RigSpec, Ellipse, arc_quality, ring_pair,
                                  find_rims, pose_from_rims, plausible,
                                  max_gradient, MIN_RING_SEPARATION_PX)

N = 60
USE_BOARD = True
for a in sys.argv[1:]:
    if a == "--no-board":
        USE_BOARD = False
    else:
        N = int(a)

W = 1920
cfg = config.load(); c = cfg["camera"]; fr = cfg.get("frame_rig", {})
H = int(round(W * c["height"] / c["width"]))
it = I.load(width=W, height=H)
if not it.calibrated:
    print("REFUSING: intrinsics are the assumed-FOV fallback, so every "
          "distance below would be a guess dressed as a measurement.")
    sys.exit(2)
rig = RigSpec(radius_mm=float(fr.get("radius_mm", 25.0)),
              inner_radius_mm=float(fr.get("inner_radius_mm", 22.0)),
              separation_mm=float(fr.get("separation_mm", 71.0)))
board = MarkerBoard(rig_geometry.OBJ_POINTS, rig_geometry.MARKER_IDS,
                    rig_geometry.DICT, it.K, it.dist_coeffs,
                    min_markers=int(cfg.get("marker_rig", {})
                                    .get("min_markers", 3)))

expo = int(fr.get("rim_exposure", 312))
gain = int(fr.get("rim_gain", 192))
print("%dx%d  fx=%.1f (calibrated)  exposure %d gain %d" % (W, H, it.fx, expo, gain))
print("rig: outer r=%.1f mm  inner r=%.1f mm  ratio %.4f\n"
      % (rig.radius_mm, rig.inner_radius_mm, rig.ring_ratio))

cam = camera.Camera(c["device"], W, H, c["fps"], c["fourcc"],
                    expo, c["focus"], gain).open()
for _ in range(12):
    cam.read()

# Seed the rim size gate from the board when we have it; otherwise carry the
# last good rim distance forward. Never a hardcoded guess -- the size gate is
# +/-45%, so a bad seed silently excludes the true rim.
seed = 600.0
rows, n_board, n_annulus, n_pair, n_single, n_frames = [], 0, 0, 0, 0, 0
singles = []
t0 = time.time()
while n_frames < N and time.time() - t0 < 90:
    f = cam.read()
    if f is None:
        continue
    n_frames += 1
    g = cv2.cvtColor(f, cv2.COLOR_BGR2GRAY)
    # The board is black-on-white and wants luminance; the rims are
    # orange-on-skin and are nearly invisible in it. Different images.
    ge = max_gradient(f)

    bp = board.detect(g) if USE_BOARD else None
    if bp is not None:
        n_board += 1
        seed = bp["distance_mm"]

    # Annulus first: it IDENTIFIES the outer edge instead of guessing.
    rim_mm, mode, rp = None, "-", None
    r = find_rims(ge, rig, it.fx, expected_distance_mm=seed, annulus=True)
    if r is not None:
        rp = pose_from_rims(r[0], r[1], rig, it.fx, it.fy, it.cx, it.cy,
                            pitch_hint_deg=0.0)
        if plausible(rp, rig):
            rim_mm, mode = rp["distance_mm"], "annulus"
            n_annulus += 1
    if rim_mm is None:
        # PAIR mode, no annulus: two rims at the right separation-to-radius
        # ratio. Weaker than the annulus because which edge we locked onto is
        # GUESSED rather than identified -- inner mistaken for outer is a
        # 13.6% scale error -- but it is a real pair constraint, which is more
        # than a single ellipse can ever offer. update.md's ladder wants this
        # as its own column for exactly that reason.
        r2 = find_rims(ge, rig, it.fx, expected_distance_mm=seed, annulus=False)
        if r2 is not None:
            p2 = pose_from_rims(r2[0], r2[1], rig, it.fx, it.fy, it.cx, it.cy,
                                pitch_hint_deg=0.0)
            if plausible(p2, rig):
                rim_mm, mode, rp = p2["distance_mm"], "pair", p2
                n_pair += 1

    if rim_mm is None:
        # Fallback: best single round candidate, scored as the OUTER edge.
        # Reported separately and never mixed into the annulus statistics --
        # if it is really the midline this is 6% low and nothing says so.
        edges = cv2.Canny(ge, 40, 120)
        cs, _ = cv2.findContours(edges, cv2.RETR_LIST, cv2.CHAIN_APPROX_NONE)
        ea = it.fx * rig.radius_mm / seed
        best = None
        for cc in cs:
            if len(cc) < 20:
                continue
            try:
                e = Ellipse.from_cv(cv2.fitEllipse(cc))
            except Exception:
                continue
            if not (ea * 0.55 <= e.a <= ea * 1.45) or e.axis_ratio < 0.70:
                continue
            cov, res = arc_quality(cc, e)
            # Same 0.06 residual gate as find_rims. Scoring by cov*ratio was
            # actively wrong here: a SQUARE scores 1.00 on both, so the
            # fallback was ranking background boxes above the real rim and
            # reporting an implied radius of 35 mm. Rank by fit residual --
            # the one statistic a square cannot fake.
            if cov < 0.45 or res > 0.06:
                continue
            if best is None or res < best[0]:
                best = (res, e, cov)
        if best is not None:
            rim_mm, mode = it.fx * rig.radius_mm / best[1].a, "single"
            singles.append((best[1], best[0], best[2]))
            n_single += 1

    if bp is not None or rim_mm is not None:
        rows.append((bp["distance_mm"] if bp else None,
                     bp["reproj_px"] if bp else None,
                     bp["yaw_deg"] if bp else None,
                     rim_mm, mode,
                     rp["yaw_deg"] if rp else None))

cam.close()

print("frames %d | board %d (%.0f%%) | annulus %d (%.0f%%) | pair %d (%.0f%%)"
      " | single %d (%.0f%%)"
      % (n_frames, n_board, 100.0*n_board/max(n_frames,1),
         n_annulus, 100.0*n_annulus/max(n_frames,1),
         n_pair, 100.0*n_pair/max(n_frames,1),
         n_single, 100.0*n_single/max(n_frames,1)))

bd = [r[0] for r in rows if r[0] is not None]
if bd:
    rj = [r[1] for r in rows if r[1] is not None]
    print("\nBOARD  distance %.1f +/- %.1f mm   reproj %.2f px (>1 px means the"
          " geometry or intrinsics are wrong)" % (np.mean(bd), np.std(bd), np.mean(rj)))

for want in ("annulus", "pair", "single"):
    v = [r[3] for r in rows if r[4] == want and r[3] is not None]
    if not v:
        continue
    print("RIM %-8s distance %.1f +/- %.1f mm  (n=%d)"
          % (want, np.mean(v), np.std(v), len(v)))
    paired = [(r[0], r[3]) for r in rows if r[4] == want and r[0] is not None]
    if len(paired) >= 3:
        d = np.array([b - m for b, m in paired])
        print("    vs board: BIAS %+.1f mm (subtracts out)   JITTER %.1f mm"
              "  (n=%d)" % (d.mean(), d.std(), len(d)))
        print("    -> implied true outer radius %.2f mm if the bias is all radius"
              % (rig.radius_mm * np.mean([m for _, m in paired])
                 / np.mean([b for b, _ in paired])))

if not rows:
    print("\nnothing detected at all -- check the frame is in view and lit")

if singles:
    xs = np.array([[e.cx, e.cy, e.a, r, c] for e, r, c in singles])
    print("\nsingle-edge fits: a %.1f +/- %.1f px at (%.0f +/- %.0f, %.0f +/- %.0f)"
          "  res %.3f  cov %.2f"
          % (xs[:,2].mean(), xs[:,2].std(), xs[:,0].mean(), xs[:,0].std(),
             xs[:,1].mean(), xs[:,1].std(), xs[:,3].mean(), xs[:,4].mean()))
    if xs[:,0].std() > 150 or xs[:,1].std() > 150:
        print("    WANDERING -- these are not one object, so the distance above"
              " is meaningless")
