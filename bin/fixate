#!/usr/bin/env python3
"""How noisy is the gaze point while the eyes are NOT moving?

The question this answers: "my eyes are not moving but the cursor jumps" --
is that independent frame-to-frame jitter, or slow drift? They look identical
on screen and they call for opposite fixes.

  INDEPENDENT jitter -> averaging N samples cuts it by sqrt(N), so a dwell
                        UI gets precision for free and nothing else is needed.
  CORRELATED drift   -> averaging buys almost nothing, and the answer is more
                        pixels on the iris (closer camera, narrower lens) or
                        online recalibration.

Why this matters so much here: the whole screen is only ~14 px of iris travel,
so the mapping multiplies iris error by about 139. One pixel of landmark noise
is 2.8 deg of gaze. At a measured 3.27 deg the pipeline is sitting at roughly
ONE PIXEL of iris precision, which is near the floor of what the landmark
model does in a single frame. Whether that floor can be beaten by time is
exactly what this measures.

Stare at the dot. Do not chase it, do not blink deliberately, just hold it.

    bin/fixate                 calibrate, then 15 s on one point
    bin/fixate --seconds 30    longer is better for the drift estimate
    bin/fixate --no-cal        reuse nothing; raw feature noise only
"""

import argparse
import json
import math
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import cv2
import numpy as np

from spike import backends, calib, camera, config, features, nosleep
from spike.targets import WIN, collect_point, grid_points, shuffled


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--seconds", type=float, default=15.0)
    ap.add_argument("--points", type=int, default=9)
    ap.add_argument("--no-cal", action="store_true",
                    help="skip calibration; report raw iris-feature noise only")
    ap.add_argument("--windowed", action="store_true")
    ap.add_argument("--label", default=None,
                    help="name this condition, e.g. ir_on / ir_off; results "
                         "append to board_artifacts/fixate.jsonl for A/B")
    args = ap.parse_args()

    cfg = config.load(os.path.join(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__))), "config.toml"))
    W, H = cfg["screen"]["width_px"], cfg["screen"]["height_px"]
    mmx = cfg["screen"]["width_mm"] / float(W)
    D = cfg["screen"]["viewing_distance_mm"]

    c = cfg["camera"]
    cam = camera.Camera(c["device"], c["width"], c["height"], c["fps"],
                        c["fourcc"], c["exposure"], c["focus"], c["gain"]).open()
    be = backends.create(prefer=cfg["inference"]["backend"])

    cv2.namedWindow(WIN, cv2.WINDOW_NORMAL)
    if not args.windowed:
        cv2.setWindowProperty(WIN, cv2.WND_PROP_FULLSCREEN, cv2.WINDOW_FULLSCREEN)
    nosleep.hold()
    canvas = np.zeros((H, W, 3), np.uint8)

    mapper = None
    if not args.no_cal:
        rng = np.random.default_rng(0)
        pts, _ = shuffled(grid_points(args.points, W, H), rng)
        X, y = [], []
        for i, pt in enumerate(pts):
            got = collect_point(cam, be, cfg, canvas, pt,
                                "%d / %d" % (i + 1, len(pts)))
            if got is None:
                cam.close(); be.close(); cv2.destroyAllWindows(); return
            X.append(got); y.append(pt)
        mapper = calib.LinearMapper().fit(np.asarray(X),
                                          np.asarray(y, dtype=float))

    target = (W // 2, H // 2)
    size = cfg["inference"]["input_size"]
    pts_xy, feats, times = [], [], []
    t0 = time.perf_counter()
    while time.perf_counter() - t0 < args.seconds:
        frame = cam.read()
        if frame is None:
            continue
        fh, fw = frame.shape[:2]
        s = float(size) / max(fh, fw)
        small = (cv2.resize(frame, (int(fw * s), int(fh * s)),
                            interpolation=cv2.INTER_AREA) if s < 1 else frame)
        rgb = cv2.cvtColor(small, cv2.COLOR_BGR2RGB)
        res = be.detect(rgb, full=None if s >= 1
                        else cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
        if not res.ok:
            continue
        try:
            f, diag = features.extract(res.landmarks, rgb.shape[1], rgb.shape[0])
        except Exception:
            continue
        if features.is_blinking(diag, cfg["inference"]["blink_ear_threshold"]):
            continue
        feats.append(f)
        times.append(time.perf_counter())
        if mapper is not None:
            pts_xy.append(mapper.predict(f))

        canvas[:] = (12, 12, 16)
        left = args.seconds - (time.perf_counter() - t0)
        cv2.circle(canvas, target, 26, (70, 140, 220), 2, cv2.LINE_AA)
        cv2.circle(canvas, target, 5, (245, 245, 250), -1, cv2.LINE_AA)
        cv2.putText(canvas, "HOLD YOUR EYES ON THE DOT", (W // 2 - 380, 120),
                    cv2.FONT_HERSHEY_SIMPLEX, 1.4, (200, 200, 210), 3, cv2.LINE_AA)
        cv2.putText(canvas, "%.0f s   %d samples" % (left, len(feats)),
                    (W // 2 - 140, H - 80), cv2.FONT_HERSHEY_SIMPLEX, 1.0,
                    (140, 140, 155), 2, cv2.LINE_AA)
        cv2.imshow(WIN, canvas)
        if (cv2.waitKey(1) & 0xFF) == ord('q'):
            break

    cam.close(); be.close(); cv2.destroyAllWindows()

    F = np.asarray(feats)
    if len(F) < 30:
        print("only %d samples -- not enough" % len(F)); return
    dt = np.diff(times)
    rate = 1.0 / np.median(dt)
    print("\n%d samples over %.1f s  (%.1f Hz)" % (len(F), times[-1] - times[0], rate))

    # --- raw feature noise, in the units the mapping actually consumes -------
    print("\nRAW IRIS FEATURE NOISE (normalised units, and what they cost):")
    fx = 1366.05 * cfg["camera"]["width"] / 1920.0
    for i, nm in enumerate(("l_iris_x", "l_iris_y", "r_iris_x", "r_iris_y")):
        sd = F[:, i].std()
        print("  %-10s sd %.5f" % (nm, sd))

    if not pts_xy:
        return

    P = np.asarray(pts_xy)
    r = np.hypot(P[:, 0] - P[:, 0].mean(), P[:, 1] - P[:, 1].mean())
    deg = np.degrees(np.arctan(r * mmx / D))
    print("\nGAZE POINT SCATTER ABOUT ITS OWN MEAN (this is the jumpiness):")
    print("  sd  x %.0f px   y %.0f px" % (P[:, 0].std(), P[:, 1].std()))
    print("  radial p50 %.0f px (%.2f deg)   p95 %.0f px (%.2f deg)"
          % (np.percentile(r, 50), np.percentile(deg, 50),
             np.percentile(r, 95), np.percentile(deg, 95)))

    # --- the decisive part: does averaging actually help? -------------------
    #
    # If samples are independent, the sd of a block mean falls as 1/sqrt(N).
    # If they are correlated -- slow drift rather than jitter -- it falls much
    # more slowly, and a dwell UI gains almost nothing by waiting.
    print("\nDOES AVERAGING HELP? sd of the mean of N consecutive samples:")
    print("  %4s %8s %10s %10s %s" % ("N", "ms", "sd px", "ideal", "verdict"))
    base = None
    for n in (1, 2, 4, 8, 16, 32):
        if len(P) < n * 4:
            break
        k = len(P) // n
        blocks = P[:k * n].reshape(k, n, 2).mean(axis=1)
        sd = float(np.hypot(blocks[:, 0].std(), blocks[:, 1].std()))
        if base is None:
            base = sd
        ideal = base / math.sqrt(n)
        ratio = sd / ideal if ideal > 0 else float("inf")
        verdict = ("independent" if ratio < 1.3 else
                   "partly correlated" if ratio < 2.0 else "CORRELATED - drift")
        print("  %4d %8.0f %10.1f %10.1f %s"
              % (n, 1000.0 * n / rate, sd, ideal, verdict))

    # Lag-1 autocorrelation is the same question asked directly.
    for j, nm in (("x", 0), ("y", 1))[:0]:
        pass
    for nm, j in (("x", 0), ("y", 1)):
        v = P[:, j] - P[:, j].mean()
        ac = float(np.corrcoef(v[:-1], v[1:])[0, 1])
        print("  lag-1 autocorrelation %s: %+.2f  (%s)"
              % (nm, ac, "independent jitter" if abs(ac) < 0.3
                 else "correlated -- drift or tracking, not noise"))

    # --- iris-region contrast, the thing an IR lamp is meant to change ----
    #
    # Brightness alone does not predict landmark quality -- that was measured
    # for the rim detector and it holds here. What should matter is how well
    # the iris stands out from the sclera, because that edge is what the
    # landmark model localises. Report it so "the picture looks brighter" and
    # "the tracker got better" cannot be confused.
    res = {}
    if args.label:
        res = dict(
            label=args.label,
            when=time.strftime("%Y-%m-%dT%H:%M:%S"),
            n=len(F),
            rate=round(rate, 1),
            iris_sd=[round(float(F[:, i].std()), 5) for i in range(4)],
        )
        if pts_xy:
            res["scatter_px_p50"] = round(float(np.percentile(r, 50)), 1)
            res["scatter_deg_p50"] = round(float(np.percentile(deg, 50)), 3)
            res["sd_x"] = round(float(P[:, 0].std()), 1)
            res["sd_y"] = round(float(P[:, 1].std()), 1)
            k = 8
            if len(P) >= k * 4:
                kk = len(P) // k
                blocks = P[:kk * k].reshape(kk, k, 2).mean(axis=1)
                res["sd_mean_of_8"] = round(
                    float(np.hypot(blocks[:, 0].std(), blocks[:, 1].std())), 1)
            v = P[:, 0] - P[:, 0].mean()
            res["autocorr_x"] = round(float(np.corrcoef(v[:-1], v[1:])[0, 1]), 3)
        out = os.path.join(os.path.dirname(os.path.dirname(
            os.path.abspath(__file__))), "board_artifacts", "fixate.jsonl")
        try:
            os.makedirs(os.path.dirname(out), exist_ok=True)
            with open(out, "a") as fh:
                fh.write(json.dumps(res) + "\n")
            print("\nappended %r to %s" % (args.label, out))
        except Exception as e:
            print("\ncould not append: %s" % e)

        # If there is a previous run under a different label, diff them now --
        # an A/B you have to go and compute yourself is an A/B nobody computes.
        try:
            prev = [json.loads(l) for l in open(out)]
            others = [x for x in prev[:-1] if x.get("label") != args.label
                      and x.get("scatter_px_p50")]
            if others and res.get("scatter_px_p50"):
                o = others[-1]
                a, b = o["scatter_px_p50"], res["scatter_px_p50"]
                print("\nA/B  %-10s %6.1f px" % (o["label"], a))
                print("     %-10s %6.1f px   -> %+.0f%%"
                      % (args.label, b, 100.0 * (b - a) / max(a, 1e-6)))
                print("     (fixation scatter; LOWER is better. This, not"
                      " brightness, is the thing that matters.)")
        except Exception:
            pass

    print("\nREAD IT LIKE THIS:")
    print("  independent  -> average over the dwell. 8 samples is 0.5 s and")
    print("                  cuts the error by 2.8x for free.")
    print("  correlated   -> averaging will NOT help. The answer is more")
    print("                  pixels on the iris: move the camera closer, or")
    print("                  a narrower lens. See PLAN.md Path C.")


if __name__ == "__main__":
    main()
