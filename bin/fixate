#!/usr/bin/env python3
"""How steady is the gaze point while the eyes hold still? A/B-capable.

WHY THIS WAS REBUILT. The first version showed one dot for 15 s and reported
the scatter about its single mean. Two runs of the SAME condition then gave
153.8 px and 276.9 px -- an 80% spread -- which made any A/B meaningless: a
single on-versus-off comparison reports whichever way the noise fell.

The cause was in the statistic, not the tracker. Lag-1 autocorrelation ran
0.60-0.74, i.e. the sample-to-sample signal was dominated by something slow.
Nobody holds a fixation for 15 s; the eyes creep, the head settles, the chair
moves. All of that landed in "tracker noise".

WHAT CHANGED

  MANY SHORT FIXATIONS, not one long one. Each dot is held for ~1.5 s after a
  settle, and scatter is measured about THAT fixation's own mean. Drift
  between fixations cannot contaminate it, because each is its own baseline.

  POSITIONS VARY. A single centre dot measures the tracker where it is best.
  Dots are drawn from a grid across the screen, shuffled.

  THE RUN IS A DISTRIBUTION, not a point. The statistic is the median
  per-fixation scatter over ~20 fixations, and a bootstrap gives it a
  confidence interval -- so "is this difference real" is answerable instead
  of guessed at.

  SETTLE TIME IS DISCARDED. The first samples after a dot moves are a saccade
  and its overshoot, not a fixation.

    bin/fixate --label room_only
    bin/fixate --label room_plus_lamp     # prints the A/B with a CI
"""

import argparse
import json
import math
import os
import random
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import cv2
import numpy as np

from spike import backends, calib, camera, config, features, nosleep
from spike.targets import WIN, collect_point, grid_points, shuffled


def boot_ci(vals, stat=np.median, n=2000, alpha=0.05, rng=None):
    """Bootstrap CI. Small samples make a point estimate look authoritative;
    this says how much of that is warranted."""
    if len(vals) < 3:
        return (float("nan"), float("nan"))
    rng = rng or np.random.default_rng(0)
    a = np.asarray(vals, dtype=float)
    boots = [stat(rng.choice(a, size=len(a), replace=True)) for _ in range(n)]
    return (float(np.percentile(boots, 100 * alpha / 2)),
            float(np.percentile(boots, 100 * (1 - alpha / 2))))


def beep(kind=None):
    try:
        import subprocess
        here = os.path.dirname(os.path.abspath(__file__))
        subprocess.run(["python3", os.path.join(here, "beep")]
                       + ([kind] if kind else []),
                       capture_output=True, timeout=8)
    except Exception:
        pass


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--label", required=True)
    ap.add_argument("--fixations", type=int, default=20)
    ap.add_argument("--hold", type=float, default=1.5,
                    help="seconds of samples kept per fixation")
    ap.add_argument("--settle", type=float, default=0.6,
                    help="seconds discarded after the dot moves (saccade)")
    ap.add_argument("--points", type=int, default=9)
    ap.add_argument("--windowed", action="store_true")
    ap.add_argument("--seed", type=int, default=None)
    args = ap.parse_args()

    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    cfg = config.load(os.path.join(root, "config.toml"))
    W, H = cfg["screen"]["width_px"], cfg["screen"]["height_px"]
    mmx = cfg["screen"]["width_mm"] / float(W)
    D = cfg["screen"]["viewing_distance_mm"]

    c = cfg["camera"]
    cam = camera.Camera(c["device"], c["width"], c["height"], c["fps"],
                        c["fourcc"], c["exposure"], c["focus"], c["gain"]).open()
    be = backends.create(prefer=cfg["inference"]["backend"])

    cv2.namedWindow(WIN, cv2.WINDOW_NORMAL)
    if not args.windowed:
        cv2.setWindowProperty(WIN, cv2.WND_PROP_FULLSCREEN, cv2.WINDOW_FULLSCREEN)
    nosleep.hold()
    canvas = np.zeros((H, W, 3), np.uint8)

    seed = args.seed if args.seed is not None else random.randrange(2 ** 31)
    rng = np.random.default_rng(seed)

    beep()
    pts, _ = shuffled(grid_points(args.points, W, H), rng)
    X, y = [], []
    for i, pt in enumerate(pts):
        got = collect_point(cam, be, cfg, canvas, pt, "%d / %d" % (i + 1, len(pts)))
        if got is None:
            cam.close(); be.close(); cv2.destroyAllWindows(); return
        X.append(got); y.append(pt)
    mapper = calib.LinearMapper().fit(np.asarray(X), np.asarray(y, dtype=float))

    # Fixation targets: a wider grid than the calibration one, shuffled, and
    # repeated until `fixations` is reached. Varying position matters -- a
    # single centre dot measures the tracker where it performs best.
    fix_pts, _ = shuffled(grid_points(9, W, H, margin=0.18), rng)
    while len(fix_pts) < args.fixations:
        more, _ = shuffled(grid_points(9, W, H, margin=0.18), rng)
        fix_pts += more
    fix_pts = fix_pts[:args.fixations]

    size = cfg["inference"]["input_size"]
    per_fix, kept_total, rate_n, rate_t0 = [], 0, 0, time.perf_counter()

    beep("--go")
    for i, (tx, ty) in enumerate(fix_pts):
        t0 = time.perf_counter()
        samples = []
        while True:
            el = time.perf_counter() - t0
            if el > args.settle + args.hold:
                break
            canvas[:] = (12, 12, 16)
            phase = min(1.0, el / args.settle)
            r = int(30 - 16 * phase)
            col = (245, 245, 250) if el >= args.settle else (90, 140, 200)
            cv2.circle(canvas, (tx, ty), r, (70, 140, 220), 2, cv2.LINE_AA)
            cv2.circle(canvas, (tx, ty), 5, col, -1, cv2.LINE_AA)
            cv2.putText(canvas, "%d / %d" % (i + 1, len(fix_pts)),
                        (W // 2 - 60, 70), cv2.FONT_HERSHEY_SIMPLEX, 1.0,
                        (120, 120, 135), 2, cv2.LINE_AA)
            cv2.imshow(WIN, canvas)
            if (cv2.waitKey(1) & 0xFF) == ord('q'):
                cam.close(); be.close(); cv2.destroyAllWindows(); return

            frame = cam.read()
            if frame is None:
                continue
            rate_n += 1
            fh, fw = frame.shape[:2]
            s = float(size) / max(fh, fw)
            small = (cv2.resize(frame, (int(fw * s), int(fh * s)),
                                interpolation=cv2.INTER_AREA) if s < 1 else frame)
            res = be.detect(cv2.cvtColor(small, cv2.COLOR_BGR2RGB),
                            full=None if s >= 1
                            else cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
            if not res.ok:
                continue
            try:
                f, diag = features.extract(res.landmarks, small.shape[1],
                                           small.shape[0])
            except Exception:
                continue
            if features.is_blinking(diag, cfg["inference"]["blink_ear_threshold"]):
                continue
            if el < args.settle:          # saccade and overshoot: discard
                continue
            samples.append(mapper.predict(f))

        if len(samples) >= 5:
            P = np.asarray(samples)
            # Scatter about THIS fixation's own mean. Drift between fixations
            # cannot leak in, which is the whole point of the rebuild.
            sd = float(np.hypot(P[:, 0].std(), P[:, 1].std()))
            off = float(np.hypot(P[:, 0].mean() - tx, P[:, 1].mean() - ty))
            per_fix.append(dict(n=len(samples), scatter_px=sd, offset_px=off,
                                tx=tx, ty=ty))
            kept_total += len(samples)

    cam.close(); be.close(); cv2.destroyAllWindows()
    beep("--done")

    if len(per_fix) < 5:
        print("only %d usable fixations -- not enough" % len(per_fix))
        return

    rate = rate_n / max(1e-6, time.perf_counter() - rate_t0)
    sc = [f["scatter_px"] for f in per_fix]
    off = [f["offset_px"] for f in per_fix]
    lo, hi = boot_ci(sc)

    def deg(px):
        return math.degrees(math.atan(px * mmx / D))

    print("\n%s: %d fixations, %d samples, %.1f Hz"
          % (args.label, len(per_fix), kept_total, rate))
    print("\nPER-FIXATION SCATTER (steadiness -- what a lamp should improve):")
    print("  median %.1f px (%.2f deg)   95%% CI [%.1f, %.1f]"
          % (np.median(sc), deg(np.median(sc)), lo, hi))
    print("  IQR %.1f-%.1f px   worst %.1f"
          % (np.percentile(sc, 25), np.percentile(sc, 75), max(sc)))
    print("\nOFFSET FROM THE DOT (accuracy -- what calibration should improve):")
    print("  median %.1f px (%.2f deg)" % (np.median(off), deg(np.median(off))))

    res = dict(label=args.label, when=time.strftime("%Y-%m-%dT%H:%M:%S"),
               seed=seed, fixations=len(per_fix), samples=kept_total,
               rate=round(rate, 1),
               scatter_median=round(float(np.median(sc)), 1),
               scatter_ci=[round(lo, 1), round(hi, 1)],
               scatter_deg=round(deg(float(np.median(sc))), 3),
               offset_median=round(float(np.median(off)), 1),
               per_fixation=[round(v, 1) for v in sc])
    out = os.path.join(root, "board_artifacts", "fixate.jsonl")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "a") as fh:
        fh.write(json.dumps(res) + "\n")
    print("\nappended %r to %s" % (args.label, out))

    # --- A/B against every previous run under other labels ------------------
    prev = [json.loads(l) for l in open(out) if '"per_fixation"' in l]
    mine = [p for p in prev if p["label"] == args.label]
    others = {}
    for p in prev:
        if p["label"] != args.label:
            others.setdefault(p["label"], []).append(p)
    if others:
        a = [v for p in mine for v in p["per_fixation"]]
        print("\nA/B  (per-fixation scatter, pooled; LOWER is better)")
        print("  %-18s %7s %7s %s" % ("condition", "median", "n", "95% CI"))
        print("  %-18s %7.1f %7d [%.1f, %.1f]"
              % (args.label, np.median(a), len(a), *boot_ci(a)))
        rng2 = np.random.default_rng(1)
        for lab, runs in others.items():
            b = [v for p in runs for v in p["per_fixation"]]
            print("  %-18s %7.1f %7d [%.1f, %.1f]"
                  % (lab, np.median(b), len(b), *boot_ci(b)))
            # Bootstrap the DIFFERENCE. Overlapping CIs on two medians is not
            # the same test, and is the one people do by eye and get wrong.
            d = [np.median(rng2.choice(a, len(a), True))
                 - np.median(rng2.choice(b, len(b), True)) for _ in range(2000)]
            dlo, dhi = np.percentile(d, [2.5, 97.5])
            verdict = ("REAL: %s is steadier" % (args.label if np.median(d) < 0 else lab)
                       if (dlo > 0) == (dhi > 0) else
                       "NOT RESOLVED -- the interval spans zero")
            print("      difference %+.1f px, 95%% CI [%+.1f, %+.1f]  -> %s"
                  % (np.median(d), dlo, dhi, verdict))
        if len(mine) < 2:
            print("\n  Only one run of %r. Run each condition at least twice,"
                  % args.label)
            print("  ALTERNATING, or a drift in the subject over the session")
            print("  is indistinguishable from an effect of the lamp.")


if __name__ == "__main__":
    main()
