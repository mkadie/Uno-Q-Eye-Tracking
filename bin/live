#!/usr/bin/env python3
"""Live gaze cursor on the UNO Q's own monitor, with the glasses fiducial overlaid.

This is a VISUALISATION of what has been measured, not a working pointer. Read
RESULTS.md before drawing conclusions from it: the honest held-out accuracy is
~8 deg uncalibrated falling to ~5 deg after 20 online clicks, which is
PLAN.md's Path C. The dot will visibly miss. That is the measurement, not a bug.

It calibrates FIRST, every time, and deliberately offers no way to load a saved
mapping. MEASURED 2026-08-16: the 66-parameter fit does not transfer across a
session boundary at all -- 49 to 168 deg, same person, same rig, minutes apart.
A demo that loaded yesterday's calibration would look broken for a reason that
has nothing to do with the tracker.

The glasses fiducial is overlaid when it locks on, and drives nothing. At the
2026-09-16 baseline it was usable on 2% of frames; that is fine for the jobs it
is meant to do later (distance zones, eye ROI, pitch hint) and nowhere near
good enough to put in the cursor path today.

  bin/live                       9-point calibrate, then live
  bin/live --points 16           denser calibration
  bin/live --exposure 625        brighter room setting (costs fps)
  bin/live --no-rims             skip the fiducial overlay entirely

Keys:  q quit    r recalibrate    d cycle diagnostics    SPACE freeze
"""

import argparse
import math
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import cv2
import numpy as np

from spike import backends, calib, camera, config, features
from spike.frame_fiducial import RigSpec, find_rims, plausible, pose_from_rims
from spike.oneeuro import OneEuroFilter2D
from spike.targets import collect_point, grid_points, shuffled

WIN = "gaze"


def calibrate(cam, be, cfg, canvas, n_pts, rng):
    """Same routine as bin/calibrate, inline, randomised order."""
    W, H = canvas.shape[1], canvas.shape[0]
    pts, _ = shuffled(grid_points(n_pts, W, H), rng)
    X, y = [], []
    for i, pt in enumerate(pts):
        f = collect_point(cam, be, cfg, canvas, pt,
                          "calibrating  %d/%d   (q aborts)" % (i + 1, len(pts)))
        if f is None:
            return None
        X.append(f)
        y.append(pt)
    return calib.GazeMapper(
        ridge=cfg["calibration"]["ridge"],
        ring_size=cfg["calibration"]["ring_size"],
        refit_every=cfg["calibration"]["refit_every"]).fit(X, y)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--config", default=None)
    ap.add_argument("--points", type=int, default=9)
    ap.add_argument("--exposure", type=int, default=None)
    ap.add_argument("--no-rims", action="store_true", dest="no_rims")
    ap.add_argument("--windowed", action="store_true")
    ap.add_argument("--seed", type=int, default=7)
    args = ap.parse_args()

    cfg = config.load(args.config)
    c = cfg["camera"]
    fr = cfg.get("frame_rig", {})
    W = cfg["screen"]["width_px"]
    H = cfg["screen"]["height_px"]
    size = cfg["inference"]["input_size"]
    blink_thr = cfg["inference"]["blink_ear_threshold"]

    exposure = args.exposure if args.exposure is not None else c["exposure"]
    cam = camera.Camera(c["device"], c["width"], c["height"], c["fps"],
                        c["fourcc"], exposure, c["focus"], c["gain"]).open()
    be = backends.create(prefer=cfg["inference"]["backend"])

    rig = RigSpec(radius_mm=float(fr.get("radius_mm", 23.5)),
                  separation_mm=float(fr.get("separation_mm", 62.7)),
                  measured_n=int(fr.get("measured_n", 0)))
    every_n = int(fr.get("detect_every_n", 5))
    from spike import intrinsics as _intr
    _it = _intr.load(width=c["width"], height=c["height"])
    cam_fx = _it.fx
    cam_cx, cam_cy = _it.cx, _it.cy

    cv2.namedWindow(WIN, cv2.WINDOW_NORMAL)
    if not args.windowed:
        cv2.setWindowProperty(WIN, cv2.WND_PROP_FULLSCREEN,
                              cv2.WINDOW_FULLSCREEN)
    canvas = np.zeros((H, W, 3), dtype=np.uint8)
    rng = np.random.default_rng(args.seed)

    mapper = calibrate(cam, be, cfg, canvas, args.points, rng)
    if mapper is None:
        cam.close(); be.close(); cv2.destroyAllWindows()
        return 1

    f = cfg["filter"]
    smooth = OneEuroFilter2D(min_cutoff=f["min_cutoff"], beta=f["beta"],
                             d_cutoff=f["d_cutoff"])

    trail, diag_mode, frozen = [], 1, False
    rim_pose, rim_pair, rim_age = None, None, 999
    fps_hist, t_prev = [], time.perf_counter()
    i = 0

    while True:
        i += 1
        frame = cam.read()
        if frame is None:
            continue
        now = time.perf_counter()
        dt = now - t_prev
        t_prev = now
        if dt > 0:
            fps_hist.append(1.0 / dt)
            if len(fps_hist) > 30:
                fps_hist.pop(0)

        h, w = frame.shape[:2]
        s = float(size) / max(h, w)
        small = cv2.resize(frame, (int(w * s), int(h * s)),
                           interpolation=cv2.INTER_AREA) if s < 1 else frame
        rgb = cv2.cvtColor(small, cv2.COLOR_BGR2RGB)

        # --- the fiducial, on its own slow cadence -----------------------
        # Head pose moves slowly next to gaze, which is the whole reason this
        # is affordable. It drives NOTHING here -- see the module docstring.
        if not args.no_rims and i % every_n == 0:
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            found = find_rims(gray, rig, cam_fx, expected_distance_mm=508.0)
            if found is not None:
                p = pose_from_rims(found[0], found[1], rig, cam_fx, cam_fx,
                                   cam_cx, cam_cy, pitch_hint_deg=0.0)
                if plausible(p, rig):
                    rim_pose, rim_pair, rim_age = p, found, 0
            rim_age += 1

        res = be.detect(rgb)
        gaze, blinking, dist_mm = None, False, None
        if res.ok:
            try:
                feat, d = features.extract(res.landmarks, rgb.shape[1],
                                           rgb.shape[0])
                blinking = features.is_blinking(d, blink_thr)
                dist_mm = d.get("distance_mm")
                if not blinking:
                    raw = mapper.predict(feat)
                    gaze = smooth(float(raw[0]), float(raw[1]), now)
            except Exception:
                pass

        # --- draw --------------------------------------------------------
        if not frozen:
            canvas[:] = (14, 14, 17)

            if gaze is not None:
                trail.append(gaze)
                if len(trail) > 24:
                    trail.pop(0)
            for k, (gx, gy) in enumerate(trail):
                a = (k + 1) / float(len(trail))
                cv2.circle(canvas, (int(gx), int(gy)), 3,
                           (int(60 * a), int(90 * a), int(120 * a)), -1,
                           cv2.LINE_AA)
            if gaze is not None:
                gx, gy = int(gaze[0]), int(gaze[1])
                cv2.circle(canvas, (gx, gy), 34, (70, 140, 220), 2, cv2.LINE_AA)
                cv2.circle(canvas, (gx, gy), 6, (240, 240, 245), -1, cv2.LINE_AA)
                # The measured p95 error as a ring, so the dot is never read as
                # more precise than it is.
                cv2.circle(canvas, (gx, gy), int(7.95 * 58 / 2), (40, 40, 70), 1,
                           cv2.LINE_AA)

            if blinking:
                cv2.putText(canvas, "blink", (W // 2 - 40, H - 120),
                            cv2.FONT_HERSHEY_SIMPLEX, 1.0, (90, 90, 110), 2)
            elif not res.ok:
                cv2.putText(canvas, "no face", (W // 2 - 70, H - 120),
                            cv2.FONT_HERSHEY_SIMPLEX, 1.0, (80, 70, 70), 2)

            if diag_mode:
                fps = np.mean(fps_hist) if fps_hist else 0.0
                lines = ["%.1f fps   %s" % (fps, "face" if res.ok else "NO FACE")]
                if dist_mm:
                    lines.append("PnP distance %.0f mm  (canonical-face bias)"
                                 % dist_mm)
                if not args.no_rims:
                    if rim_pose is not None and rim_age < 40:
                        lines.append("RIMS  %.0f mm  yaw %+.0f  roll %+.0f  "
                                     "(age %d)"
                                     % (rim_pose["distance_mm"],
                                        rim_pose["yaw_deg"],
                                        rim_pose["roll_deg"], rim_age))
                    else:
                        lines.append("RIMS  no lock  (2%% of frames at the "
                                     "2026-09-16 baseline)")
                lines.append("measured: ~8 deg uncalibrated, ~5 deg after 20 "
                             "clicks -- PLAN.md Path C")
                for k, t in enumerate(lines):
                    cv2.putText(canvas, t, (30, 44 + 34 * k),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.7,
                                (110, 110, 125), 1, cv2.LINE_AA)

            if diag_mode > 1:
                # Camera inset, with the rim fit drawn on it when locked.
                ins = cv2.resize(frame, (320, 180))
                if rim_pair is not None and rim_age < 40:
                    sx, sy = 320.0 / frame.shape[1], 180.0 / frame.shape[0]
                    for e in rim_pair:
                        cv2.ellipse(ins, (int(e.cx * sx), int(e.cy * sy)),
                                    (max(int(e.a * sx), 1), max(int(e.b * sy), 1)),
                                    math.degrees(e.theta), 0, 360, (0, 220, 60), 1)
                canvas[H - 200:H - 20, W - 340:W - 20] = ins

            cv2.putText(canvas, "q quit   r recalibrate   d diagnostics   "
                                "SPACE freeze",
                        (30, H - 30), cv2.FONT_HERSHEY_SIMPLEX, 0.6,
                        (80, 80, 95), 1, cv2.LINE_AA)

        cv2.imshow(WIN, canvas)
        k = cv2.waitKey(1) & 0xFF
        if k == ord("q"):
            break
        if k == ord(" "):
            frozen = not frozen
        if k == ord("d"):
            diag_mode = (diag_mode + 1) % 3
        if k == ord("r"):
            m = calibrate(cam, be, cfg, canvas, args.points, rng)
            if m is not None:
                mapper = m
                trail = []
                smooth = OneEuroFilter2D(min_cutoff=f["min_cutoff"],
                                         beta=f["beta"], d_cutoff=f["d_cutoff"])

    cv2.destroyAllWindows()
    cam.close()
    be.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
