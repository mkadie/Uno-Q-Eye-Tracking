#!/usr/bin/env python3
"""T-Rex Talker 3.0 on the gaze pipeline — a 3x2 AAC board driven by eye.

An alternative test/demo to the bunny game, and a better one for the thing
this project is actually for: the bunny game measures whether gaze can chase a
moving target, this measures whether it can HOLD one of six large cells long
enough to say something. That is the real task.

WHY 3x2. MEASURED 2026-09-21: bare-faced angular error is 3.27 deg mean,
5.56 deg p95, and at 504 mm one degree is 50 px. The rule of thumb is that a
target must exceed twice the error:

    3x2 on 1920x1080 -> 640 x 540 px cells (12.8 x 10.8 deg)
      mean 3.27 deg  -> needs >= 327 px   width OK, height OK
      p95  5.56 deg  -> needs >= 556 px   width OK, height TIGHT

So 3x2 is comfortable on the mean and marginal vertically at p95, which is
exactly where a demo should sit -- it will succeed most of the time and fail
visibly rather than never. A 4x2 board (480 px wide) would be tight on BOTH
axes at p95; that is why this is not 4x2 even though the CYD device's own
base.menu is.

GAZE AIMS, A KEY SELECTS. Space or Enter. This is not a placeholder for dwell
selection -- it is the same split the whole project rests on: the UNO Q is a
pointing sensor and the breath board is the switch. Aiming and triggering are
separate abilities, and gaze gives you the first without the second. Dwell is
the fallback for someone with no switch at all, not the default.

    bin/talker                          calibrate, then the board
    bin/talker --menu path/to/x.menu
    bin/talker --mouse                  no camera, pointer only (for layout work)
    bin/talker --dwell 1.2              also select by looking for 1.2 s

Keys:  SPACE / ENTER speak    q quit    r recalibrate    b back    m mouse
Mouse: LEFT speak    RIGHT or MIDDLE back to the main menu
       the 'exit' chip, top right of the HOME board only, leaves the
       talker: click once to arm, again within 4 s to confirm.
"""

import argparse
import collections
import math
import os
import signal
import random
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

import cv2
import numpy as np

from spike import backends, calib, camera, config, features, menu as menulib
from spike import intrinsics, tagtrack
from spike import nosleep
from spike.oneeuro import OneEuroFilter2D
from spike.targets import (WIN, collect_point, draw_target, grid_points,
                           shuffled)

DEFAULT_MENU = "/home/trex/claude/coder/talker_v3/menus/base_fruitjam.menu"

BG = (18, 18, 22)
CELL = (38, 40, 52)
CELL_HOVER = (64, 96, 150)
CELL_SUB = (48, 44, 64)
EDGE = (90, 94, 110)
TEXT = (238, 238, 244)
DIM = (150, 152, 165)
ACCENT = (250, 200, 90)
OK = (110, 220, 130)
WARN = (70, 90, 210)          # BGR: a muted red, for the armed exit chip


# --------------------------------------------------------------------------
# Speech


class Voice(object):
    """Speak a press: its recorded clip if there is one, else a TTS voice.

    The recorded clips are the device's own -- a real user's board says the
    same words in the same voice, and a demo that substitutes a robot voice
    for a child's recorded "Yes" is demoing something else. TTS is the
    fallback so the board still works on a machine without the clips.
    """

    def __init__(self, sound_root=None, quiet=False):
        self.sound_root = sound_root
        self.quiet = quiet
        self.player = None
        self.tts = None
        self.mixer = None
        # pygame FIRST, and on this board it is the only thing that works:
        # MEASURED 2026-09-21, the UNO Q image ships no mpg123, ffplay, mpv,
        # espeak or spd-say. pygame-ce is already there because the bunny game
        # needs it, and its mixer opens at 44100/-16/2 without an install. A
        # demo that needs apt on a faire morning is a demo that does not run.
        try:
            import pygame
            pygame.mixer.init()
            self.mixer = pygame.mixer
        except Exception:
            self.mixer = None
        for c in ("mpg123", "ffplay", "mpv", "cvlc"):
            if shutil.which(c):
                self.player = c
                break
        for c in ("espeak-ng", "espeak", "spd-say"):
            if shutil.which(c):
                self.tts = c
                break
        self._proc = None
        self._cache = {}

    def describe(self):
        how = ("pygame.mixer" if self.mixer else
               (self.player or "none"))
        return "clips via %s   tts:%s   root:%s" % (
            how, self.tts or "none",
            os.path.basename(self.sound_root or "-"))

    def _clip(self, press):
        if not (self.sound_root and press.sound):
            return None
        # `sound = /button_sounds/yes.mp3` is absolute ON THE DEVICE, where the
        # CIRCUITPY drive is the root. Here it is a path fragment, so strip the
        # leading slash rather than reading from the host's real /.
        rel = press.sound.lstrip("/")
        p = os.path.join(self.sound_root, rel)
        return p if os.path.exists(p) else None

    def say(self, press):
        """Non-blocking: the board must stay responsive while it talks."""
        self.stop()
        if self.quiet:
            print("[say] %s" % press.text)
            return "print"
        clip = self._clip(press)
        try:
            if clip and self.mixer is not None:
                snd = self._cache.get(clip)
                if snd is None:
                    snd = self.mixer.Sound(clip)
                    self._cache[clip] = snd
                snd.play()
                return "clip"
            if clip and self.player:
                cmd = {"mpg123": ["mpg123", "-q", clip],
                       "ffplay": ["ffplay", "-nodisp", "-autoexit", "-loglevel",
                                  "quiet", clip],
                       "mpv": ["mpv", "--really-quiet", clip],
                       "cvlc": ["cvlc", "--play-and-exit", "--quiet", clip]}[self.player]
                self._proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                              stderr=subprocess.DEVNULL)
                return "clip"
            if self.tts:
                cmd = (["spd-say", press.text] if self.tts == "spd-say"
                       else [self.tts, press.text])
                self._proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                              stderr=subprocess.DEVNULL)
                return "tts"
        except Exception as e:
            print("[say] failed: %s" % e)
        print("[say] %s" % press.text)
        return "print"

    def stop(self):
        if self.mixer is not None:
            try:
                self.mixer.stop()
            except Exception:
                pass
        if self._proc is not None and self._proc.poll() is None:
            try:
                self._proc.terminate()
            except Exception:
                pass
        self._proc = None


# --------------------------------------------------------------------------
# Board drawing


def draw_trail(canvas, trail):
    """Fade in the recent gaze samples, oldest dimmest.

    This is what the tracker actually does between selections, and it is the
    thing a still screenshot otherwise cannot show: the point does not sit
    on the target, it wanders around it. Drawn on an overlay and blended so
    the older samples genuinely fade instead of stacking into a solid smear
    -- a smear reads as one big error, where the truth is many small ones
    around a centre.
    """
    if len(trail) < 2:
        return
    over = canvas.copy()
    n = len(trail)
    for i, (x, y) in enumerate(trail):
        f = (i + 1) / float(n)            # 0 = oldest, 1 = newest
        # Cyan -> white. A warm ramp vanished against the hover cell, which
        # is brown; cyan is far from every colour on this board, so the
        # trail reads on the highlighted cell and the dark ones alike.
        cv2.circle(over, (int(x), int(y)), max(2, int(3 + 4 * f)),
                   (255, int(200 + 55 * f), int(60 + 195 * f)),
                   -1, cv2.LINE_AA)
    cv2.addWeighted(over, 0.8, canvas, 0.2, 0, canvas)


def back_target(m, menu_dir, stack):
    """Where a Back press goes, or None if nowhere.

    Pop the breadcrumb first, so Back retraces the route the user actually
    took. Fall back to the menu's own `[menu] back = <file>` when there is
    nothing to pop -- a menu opened directly rather than navigated into has
    an empty stack, and without the fallback its Back cell is dead.
    """
    if stack:
        return stack.pop()
    if m.back:
        path = menulib.resolve(m.back, menu_dir)
        if path and os.path.exists(path):
            return menulib.load(path), os.path.dirname(os.path.abspath(path))
        print("back target not found: %s" % path)
    return None


# The exit chip lives in the title strip above the grid (cell_at returns
# None for y < 90), so it costs the board no word. It is deliberately small
# and jammed into the corner: gaze p95 is ~164 px, so a 170x56 target up
# there is effectively unreachable by a visitor's wandering gaze and
# trivial with the operator's mouse. That asymmetry IS the safety feature --
# the exit is for whoever is running the booth, not for whoever is sitting
# in the chair.
EXIT_W, EXIT_H, EXIT_PAD = 170, 56, 16
EXIT_ARM_S = 4.0                 # how long a first press stays armed


def exit_rect(w, h):
    x1 = w - EXIT_PAD
    return (x1 - EXIT_W, EXIT_PAD, x1, EXIT_PAD + EXIT_H)


def in_exit(x, y, w, h):
    x0, y0, x1, y1 = exit_rect(w, h)
    return x0 <= x <= x1 and y0 <= y <= y1


def draw_exit_chip(canvas, w, h, armed, hot):
    x0, y0, x1, y1 = exit_rect(w, h)
    fill = WARN if armed else (CELL_HOVER if hot else CELL)
    cv2.rectangle(canvas, (x0, y0), (x1, y1), fill, -1)
    cv2.rectangle(canvas, (x0, y0), (x1, y1), TEXT if armed else EDGE, 2)
    label = "SURE?" if armed else "exit"
    scale = 0.9 if armed else 0.8
    (tw, th), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, scale, 2)
    cv2.putText(canvas, label, ((x0 + x1 - tw) // 2, (y0 + y1 + th) // 2),
                cv2.FONT_HERSHEY_SIMPLEX, scale, TEXT if armed else DIM, 2,
                cv2.LINE_AA)


def draw_board(canvas, m, hover, w, h, status, dwell_frac=0.0):
    canvas[:] = BG
    cols, rows = m.columns, m.rows
    top = 90
    cw = w // cols
    ch = (h - top - 70) // rows
    pad = 14

    for r in range(rows):
        for c in range(cols):
            p = m.at(c, r)
            x0, y0 = c * cw + pad, top + r * ch + pad
            x1, y1 = (c + 1) * cw - pad, top + (r + 1) * ch - pad
            is_hover = (hover is not None and hover == (c, r) and p is not None)
            if p is None:
                fill = (26, 26, 32)
            elif is_hover:
                fill = CELL_HOVER
            elif p.navigates:
                fill = CELL_SUB
            else:
                fill = CELL
            cv2.rectangle(canvas, (x0, y0), (x1, y1), fill, -1)
            cv2.rectangle(canvas, (x0, y0), (x1, y1),
                          ACCENT if is_hover else EDGE, 3 if is_hover else 1)
            if p is None:
                continue

            # Word-wrap the label to the cell. A clipped word on an AAC board
            # is a cell the user cannot identify.
            words = p.label.replace("/", " / ").split()
            lines, cur = [], ""
            scale = 1.9
            for wd in words:
                t = (cur + " " + wd).strip()
                (tw, _), _ = cv2.getTextSize(t, cv2.FONT_HERSHEY_SIMPLEX, scale, 4)
                if tw > (x1 - x0) - 40 and cur:
                    lines.append(cur)
                    cur = wd
                else:
                    cur = t
            if cur:
                lines.append(cur)
            ty = (y0 + y1) // 2 - (len(lines) - 1) * 32
            for ln in lines:
                (tw, th), _ = cv2.getTextSize(ln, cv2.FONT_HERSHEY_SIMPLEX, scale, 4)
                cv2.putText(canvas, ln, ((x0 + x1 - tw) // 2, ty + th // 2),
                            cv2.FONT_HERSHEY_SIMPLEX, scale, TEXT, 4, cv2.LINE_AA)
                ty += 64
            if p.navigates:
                cv2.putText(canvas, "< back" if p.is_back else "more >",
                            (x0 + 18, y1 - 18),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.8, DIM, 2, cv2.LINE_AA)
            if is_hover and dwell_frac > 0:
                bw = int((x1 - x0 - 40) * min(1.0, dwell_frac))
                cv2.rectangle(canvas, (x0 + 20, y1 - 26),
                              (x0 + 20 + bw, y1 - 14), OK, -1)

    cv2.putText(canvas, m.name, (26, 58), cv2.FONT_HERSHEY_SIMPLEX, 1.4,
                TEXT, 3, cv2.LINE_AA)
    cv2.putText(canvas, status, (26, h - 26), cv2.FONT_HERSHEY_SIMPLEX, 0.85,
                DIM, 2, cv2.LINE_AA)


def cell_at(x, y, m, w, h):
    top = 90
    cw = w // m.columns
    ch = (h - top - 70) // m.rows
    if y < top or y > top + ch * m.rows:
        return None
    c = int(x // cw)
    r = int((y - top) // ch)
    if 0 <= c < m.columns and 0 <= r < m.rows:
        return (c, r)
    return None


def cell_centre(c, r, m, w, h):
    top = 90
    cw = w // m.columns
    ch = (h - top - 70) // m.rows
    return (c * cw + cw / 2.0, top + r * ch + ch / 2.0)


# --------------------------------------------------------------------------


def calibrate_head(cam, canvas, tracker, cal_path, W, H, tag_id):
    """Five points, affine, tag centre only. No inference runs here.

    Same on-screen sequence the eye path uses -- a dot that shrinks while it
    settles -- because a visitor should not have to learn two rituals. What
    differs is what is sampled and how a point is accepted: a tag centre is a
    hard measurement, so a point is REJECTED unless it holds still to 3 px,
    where the eye path has to accept whatever a wandering iris gives it.

    Returns (TagMapper, rms, span_px) or (None, reason, None).
    """
    # WAIT FOR THE TAG BEFORE ASKING FOR ANYTHING.
    #
    # MEASURED 2026-09-30, and the first reading of it was WRONG in a way
    # worth recording. A trial showed 1% detection then 80% then 80% on the
    # same dark screen, and I concluded the sensor needed ~8 s to settle.
    # It did not: the room lights had been off for the first trial and came
    # on during it. Frame mean barely moved (13.9 -> 17.2) because the lamp
    # lights the FACE, not the scene, which is exactly why that number
    # failed to give the confound away -- the same trap as "face brightness
    # does not predict rim detection", now on its third appearance.
    #
    # With the lights on the tag is acquired in 0.5 s. With them off it may
    # never come. Either way calibration used to start immediately and spend
    # its first points collecting nothing, then blame the user's head for
    # being unstable. Wait for real evidence the tag is visible instead: a
    # run of consecutive hits, shown honestly on screen, so nobody is left
    # staring at a dot that cannot work yet -- and so a dark room reports
    # itself as a dark room instead of as five unstable points.
    ready = 0
    t_wait = time.perf_counter()
    while ready < 5 and time.perf_counter() - t_wait < 20.0:
        canvas[:] = (16, 16, 18)
        cv2.putText(canvas, "finding the tag on your glasses...",
                    (int(W * 0.5) - 420, int(H * 0.5)),
                    cv2.FONT_HERSHEY_SIMPLEX, 1.3, (200, 200, 210), 2,
                    cv2.LINE_AA)
        cv2.putText(canvas, "face the camera and hold still",
                    (int(W * 0.5) - 300, int(H * 0.5) + 70),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (120, 120, 130), 2,
                    cv2.LINE_AA)
        cv2.imshow(WIN, canvas)
        if (cv2.waitKey(1) & 0xFF) == ord("q"):
            return None, "aborted", None
        frame = cam.read()
        if frame is None:
            continue
        if tracker.find(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)) is not None:
            ready += 1
        else:
            ready = 0
    if ready < 5:
        return None, ("tag never appeared in 20 s -- run bin/tagcheck"), None
    print("tag acquired after %.1f s; calibrating"
          % (time.perf_counter() - t_wait))

    feats, tgts = [], []
    for i, (fx, fy) in enumerate(tagtrack.CAL_POINTS):
        pt = (int(fx * W), int(fy * H))
        got = None
        for _ in range(tagtrack.RETRIES + 1):
            t0 = time.perf_counter()
            samples = []
            while True:
                el = time.perf_counter() - t0
                # Stop on SAMPLES, not on the clock -- with a cap so an
                # occluded tag cannot hang the calibration forever.
                if len(samples) >= tagtrack.TARGET_SAMPLES:
                    break
                if el >= tagtrack.SETTLE_S + tagtrack.COLLECT_MAX_S:
                    break
                phase = min(1.0, el / tagtrack.SETTLE_S)
                draw_target(canvas, pt, phase,
                            "%d / %d   point the tag at the dot"
                            % (i + 1, len(tagtrack.CAL_POINTS)))
                cv2.imshow(WIN, canvas)
                if (cv2.waitKey(1) & 0xFF) == ord("q"):
                    return None, "aborted", None
                frame = cam.read()
                if frame is None:
                    continue
                hit = tracker.find(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY))
                if hit is not None and el >= tagtrack.SETTLE_S:
                    samples.append(hit[0])
            pts = np.asarray(samples)
            jit = tagtrack.jitter_px(pts) if len(pts) else float("inf")
            if len(pts) >= tagtrack.MIN_SAMPLES and jit <= tagtrack.MAX_JITTER_PX:
                got = np.median(pts, axis=0)
                break
            print("  point %d unstable (%d samples, jitter %.1f px > %.1f) "
                  "-- retry" % (i + 1, len(pts), jit, tagtrack.MAX_JITTER_PX))
        if got is not None:
            feats.append(got)
            tgts.append((fx, fy))
    if len(feats) < tagtrack.MIN_POINTS:
        return None, "only %d of %d points held still" % (
            len(feats), len(tagtrack.CAL_POINTS)), None
    m = tagtrack.TagMapper()
    rms = m.fit(feats, tgts)
    span_px, gain = tagtrack.gain_px_per_screen(feats, tgts)
    m.save(cal_path, {"tag_id": tag_id, "res": [W, H], "rms": rms,
                      "span_px": span_px.tolist(), "points": len(feats)})
    print("head calibrated: rms %.4f of screen, tag span %.0f x %.0f px, "
          "gain %.0f x %.0f px per screen" % (rms, span_px[0], span_px[1],
                                              gain[0], gain[1]))
    return m, rms, span_px


def calibrate(cam, be, cfg, canvas, n_pts, rng, tracker=None,
              intr=None, Model=None):
    """Short grid + LINEAR model.

    MEASURED 2026-09-21: 9 points with the linear model gives 3.49 deg against
    3.01 for 25 points -- half a degree for three times the sitting -- while 9
    points with the degree-2 model gives 8.37. For someone who cannot hold
    still for two minutes, the short grid is not a compromise, it is the only
    one that happens.
    """
    # shuffled() returns (points, order) -- the order is returned so it can be
    # saved with the run. Unpacking it as one value hands the whole list to
    # collect_point as a single target.
    pts, order = shuffled(grid_points(n_pts, cfg["screen"]["width_px"],
                                      cfg["screen"]["height_px"]), rng)
    X, y = [], []
    for i, pt in enumerate(pts):
        got = collect_point(cam, be, cfg, canvas, pt,
                            "%d / %d" % (i + 1, len(pts)), tracker=tracker,
                            intr=intr)
        if got is None:
            return None
        X.append(got)
        y.append(pt)
    if len(X) < 4:
        return None
    # Same model class throughout -- only WHICH TWO COLUMNS it reads changes,
    # which is what keeps the comparison honest.
    if Model is None:
        Model = calib.TagAssistedMapper if tracker is not None else calib.LinearMapper
    m = Model().fit(np.asarray(X), np.asarray(y, dtype=float))
    print("fitted %s on %d points, %d features"
          % (Model.__name__, len(X), len(Model.COLS)))
    return m


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--menu", default=DEFAULT_MENU)
    ap.add_argument("--points", type=int, default=9)
    ap.add_argument("--mode", choices=("eye", "head", "eyetag", "eyepose"),
                    default="eye",
                    help="eye = iris + face mesh (default, unchanged). "
                         "head = ArUco tag on the glasses; no inference at "
                         "all, so it survives the head turns that end eye "
                         "tracking at ~20 deg. "
                         "eyetag = gaze with the tag's POSITION in place of "
                         "the face mesh's yaw/pitch (MEASURED WORSE -- a "
                         "centroid cannot tell translation from rotation). "
                         "eyepose = gaze with the tag's real solvePnP YAW and "
                         "PITCH in place of them: angles for angles, which is "
                         "the swap that should have been tried first.")
    ap.add_argument("--tag-id", type=int, default=tagtrack.DEFAULT_TAG_ID,
                    help="ArUco DICT_4X4_50 id on the glasses (head mode). "
                         "This rig's printed tag is id 2, not the 0 the spec "
                         "names -- a wrong id looks exactly like bad lighting.")
    ap.add_argument("--headcal", default=tagtrack.DEFAULT_CAL,
                    help="head calibration file, kept separate from the eye "
                         "model so neither can overwrite the other")
    ap.add_argument("--recal", action="store_true",
                    help="force calibration even if a saved one loads")
    ap.add_argument("--trail", type=int, default=0, metavar="N",
                    help="draw the last N gaze samples as a fading trail "
                         "(implied by --record)")
    ap.add_argument("--record", metavar="DIR",
                    help="save frames here. SIGUSR1 saves one immediately, "
                         "so a capture can be triggered over ssh by someone "
                         "with no keyboard on the board.")
    ap.add_argument("--record-cam", action="store_true",
                    help="with --record, also save the CAMERA frame at the "
                         "same instant, so the face and the screen it was "
                         "looking at are a matched pair")
    ap.add_argument("--record-every", type=float, default=0.0, metavar="SEC",
                    help="also save a frame every SEC seconds (0 = only on "
                         "SIGUSR1)")
    ap.add_argument("--mouse", action="store_true",
                    help="no camera; pointer only, for layout work")
    ap.add_argument("--dwell", type=float, default=0.0,
                    help="also select by looking for this many seconds")
    ap.add_argument("--hold", type=int, default=3,
                    help="samples a new cell must win before the hover moves")
    ap.add_argument("--smooth", type=float, default=0.35,
                    help="One Euro min_cutoff scale; lower = smoother, laggier")
    ap.add_argument("--sounds", default=None,
                    help="root holding button_sounds/ (default: next to the menu)")
    ap.add_argument("--quiet", action="store_true", help="print instead of speaking")
    ap.add_argument("--windowed", action="store_true")
    ap.add_argument("--seed", type=int, default=None)
    args = ap.parse_args()
    # Derived here, at the top, because half a dozen branches below read it
    # -- including a signal handler registered before the camera is opened.
    head = (args.mode == "head")
    eyetag = (args.mode == "eyetag")      # gaze + tag POSITION (refuted)
    eyepose = (args.mode == "eyepose")    # gaze + tag POSE (angles for angles)
    usetag = eyetag or eyepose

    cfg = config.load(os.path.join(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__))), "config.toml"))
    W = cfg["screen"]["width_px"]
    H = cfg["screen"]["height_px"]

    menu_dir = os.path.dirname(os.path.abspath(args.menu))
    m = menulib.load(args.menu)
    # Home is the board we STARTED on, not the bottom of the breadcrumb
    # stack and not the end of the `back =` chain. Those two agree with it
    # only when the user navigated down from the root; launching straight
    # into a submenu (which the kiosk menu can do) makes them disagree, and
    # the board the visitor was handed is the one "main menu" means.
    home = (m, menu_dir)
    exit_armed_until = 0.0           # first press arms, second press leaves

    # Capture. SIGUSR1 rather than a key, because the board a visitor uses
    # has no keyboard -- `kill -USR1 $(pgrep -f bin/talk[e]r)` over ssh saves
    # the frame, so the moment can be chosen by someone watching the screen.
    n_trail = args.trail or (90 if args.record else 0)
    trail = collections.deque(maxlen=n_trail) if n_trail else None
    want_shot = {"now": bool(args.record)}   # first frame on start
    # SIGUSR2 recenters the head map: one offset update that keeps the gain,
    # for when a chair shifts mid-session. NOTE the spec asked for
    # recalibrate on SIGUSR1, but SIGUSR1 already means "save a frame" in
    # this tool and that is documented in RESTART.md -- so recalibration
    # stays on `r`, which is the trigger eye mode already uses.
    want_recenter = {"now": False}
    if head:
        signal.signal(signal.SIGUSR2,
                      lambda *_: want_recenter.__setitem__("now", True))
    if args.record:
        os.makedirs(args.record, exist_ok=True)
        signal.signal(signal.SIGUSR1, lambda *_: want_shot.__setitem__("now", True))
        print("recording to %s -- kill -USR1 %d to grab a frame"
              % (args.record, os.getpid()))
    shot_n = 0
    last_auto = 0.0
    last_gx, last_gy = W // 2, H // 2   # where a lost tag holds the pointer
    last_tag = None                     # last tag centre, for SIGUSR2 recenter
    tag_seen = False
    lost_since = None
    if m.columns * m.rows != 6:
        print("note: %s is %dx%d, not 3x2 -- drawing it anyway"
              % (os.path.basename(args.menu), m.columns, m.rows))
    sound_root = args.sounds or os.path.dirname(menu_dir)
    voice = Voice(sound_root, quiet=args.quiet)
    print("menu  : %s (%dx%d, %d presses)" % (m.name, m.columns, m.rows,
                                              len(m.presses)))
    print("voice : %s" % voice.describe())

    # Check every clip in this menu AND every submenu it can reach, before a
    # visitor finds the gap by pressing a button and hearing nothing.
    #
    # MEASURED 2026-09-24: the Food & Drink submenu was entirely silent
    # because its clips live in menus/sounds/ and only button_sounds/ had been
    # copied to the board. Nothing errored -- the cell highlighted, the press
    # registered, and no sound came out. An AAC board that silently fails to
    # speak is worse than one that refuses to start.
    have, miss = menulib.audit_clips(args.menu, voice._clip)
    if miss:
        print("audio : *** %d of %d presses CANNOT SPEAK ***"
              % (len(miss), len(have) + len(miss)))
        for mn, lab, why in miss[:12]:
            print("        %-16s %-22s %s" % (mn, lab, why))
        print("        (--quiet prints instead of speaking, if that is wanted)")
    else:
        print("audio : all %d presses have a clip" % len(have))

    cam = be = mapper = None
    tracker = None
    intr = None
    if not args.mouse:
        c = cfg["camera"]
        cam = camera.Camera(c["device"], c["width"], c["height"], c["fps"],
                            c["fourcc"], c["exposure"], c["focus"],
                            c["gain"]).open()
        if head:
            # No backend at all. Head mode runs no inference -- the whole
            # cost is one ArUco scan of a small crop -- so loading LiteRT
            # here would reserve threads and memory for nothing.
            tracker = tagtrack.TagTracker(args.tag_id)
            print("head mode: ArUco DICT_4X4_50 id %d, no inference"
                  % args.tag_id)
        else:
            be = backends.create(prefer=cfg["inference"]["backend"])
            if usetag:
                # BOTH, and the tag is the cheap half: measured at 0.9 fps
                # against the face mesh's whole budget.
                tracker = tagtrack.TagTracker(args.tag_id)
                if eyepose:
                    intr = intrinsics.load(width=cfg["camera"]["width"],
                                           height=cfg["camera"]["height"])
                    print("eyepose mode: iris from the face mesh, head YAW/"
                          "PITCH from solvePnP on ArUco id %d (intrinsics "
                          "%s)" % (args.tag_id,
                                   "calibrated" if intr.calibrated
                                   else "ASSUMED -- distances will be wrong"))
                else:
                    print("eyetag mode: iris from the face mesh, head POSITION "
                          "from ArUco id %d. NOTE: measured WORSE than plain "
                          "eye mode; --mode eyepose is the corrected version."
                          % args.tag_id)

    # GUI_NORMAL is NOT cosmetic here. This OpenCV is built against Qt5, and
    # cv2.WINDOW_GUI_EXPANDED is *zero* -- so the bare WINDOW_NORMAL we used
    # to pass silently selected the expanded Qt chrome, which grabs
    # right-click for its own "Save image" popup. Right-click is the home
    # gesture on a board with no keyboard, and a popup nobody can dismiss
    # without one is the worst failure available. GUI_NORMAL (16) turns the
    # toolbar and that menu off and gives the button back to us.
    cv2.namedWindow(WIN, cv2.WINDOW_NORMAL | cv2.WINDOW_GUI_NORMAL)
    if not args.windowed:
        cv2.setWindowProperty(WIN, cv2.WND_PROP_FULLSCREEN, cv2.WINDOW_FULLSCREEN)
    # OpenCV drawing is not an input event, so X will blank on us mid-demo.
    nosleep.hold()
    canvas = np.zeros((H, W, 3), np.uint8)

    seed = args.seed if args.seed is not None else random.randrange(2 ** 31)
    rng = np.random.default_rng(seed)
    headmap = None
    if cam is not None and head:
        # A saved head calibration is reused unless --recal. The tag is rigid
        # and the fit is six parameters, so unlike the eye model it does not
        # go stale the moment the subject shifts -- and a visitor who only
        # wants to point should not sit through five dots to do it.
        headmap = tagtrack.TagMapper.load(args.headcal)
        if headmap.fitted and not args.recal:
            print("head calibration loaded from %s" % args.headcal)
        else:
            headmap, why, _ = calibrate_head(cam, canvas, tracker,
                                             args.headcal, W, H, args.tag_id)
            if headmap is None:
                print("head calibration failed: %s -- falling back to the "
                      "pointer" % why)
    elif cam is not None:
        print("calibrating %d points (seed %d)..." % (args.points, seed))
        Model = (calib.TagPoseMapper if eyepose else
                 calib.TagAssistedMapper if eyetag else calib.LinearMapper)
        mapper = calibrate(cam, be, cfg, canvas, args.points, rng,
                           tracker=tracker, intr=intr, Model=Model)
        if mapper is None:
            print("calibration aborted; falling back to the pointer")

    mouse = {"x": W // 2, "y": H // 2, "click": False, "home": False}

    def on_mouse(event, x, y, flags, param):
        mouse["x"], mouse["y"] = x, y
        if event == cv2.EVENT_LBUTTONDOWN:
            mouse["click"] = True
        # Right OR middle, because a middle button is a wheel press on most
        # mice and misses about as often as it fires. Both mean home: there
        # is no keyboard on the board, so `b` is not reachable by a visitor.
        elif event in (cv2.EVENT_RBUTTONDOWN, cv2.EVENT_MBUTTONDOWN):
            mouse["home"] = True
    cv2.setMouseCallback(WIN, on_mouse)

    # MEASURED on the bunny game, and the same failure appears here: at ~16 Hz
    # samples the raw estimate visibly steps. config.toml's min_cutoff is tuned
    # for a cursor chasing a moving target, where lag costs more than jitter.
    # An AAC board is the opposite -- the target does not move, the user is
    # fixating, and lag is nearly free. So smooth harder by default.
    filt = OneEuroFilter2D(cfg["filter"]["min_cutoff"] * args.smooth,
                           cfg["filter"]["beta"],
                           cfg["filter"]["d_cutoff"])
    stack = []                       # (menu, menu_dir) breadcrumbs
    hover = None                     # the COMMITTED cell -- what is highlighted
    cand = None                      # cell the raw gaze is in right now
    cand_n = 0                       # consecutive samples it has won
    dwell_since = None
    use_mouse = args.mouse or (headmap is None if head else mapper is None)
    # Every selection is a MEASUREMENT: where the gaze was against the cell
    # it landed in. That is what makes this a test and not a toy.
    log = []
    t_prev = time.perf_counter()

    while True:
        now = time.perf_counter()
        # The exit chip is offered on the home board ONLY. Deep in a submenu
        # it would be one more thing for a visitor to find, and the operator
        # can always right-click home first.
        at_home = (m, menu_dir) == home
        dt = now - t_prev
        t_prev = now

        gx = gy = None
        last_frame = None
        if not use_mouse and cam is not None and head:
            frame = cam.read()
            if frame is not None:
                last_frame = frame
                hit = tracker.find(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY))
                if hit is not None:
                    tag_seen = True
                    nx, ny = headmap.map(hit[0])
                    gx, gy = filt(float(nx) * W, float(ny) * H, now)
                    last_tag = hit[0]
                else:
                    # Tag lost: HOLD the pointer where it was. Do not fall
                    # through to the mouse and do not drift -- a pointer that
                    # jumps when a hand passes the glasses is worse than one
                    # that pauses, and a dwell in progress would fire on
                    # whatever it landed on.
                    tag_seen = False
                    gx, gy = last_gx, last_gy
        elif not use_mouse and cam is not None:
            frame = cam.read()
            if frame is not None:
                last_frame = frame
                size = cfg["inference"]["input_size"]
                fh, fw = frame.shape[:2]
                s = float(size) / max(fh, fw)
                small = (cv2.resize(frame, (int(fw * s), int(fh * s)),
                                    interpolation=cv2.INTER_AREA)
                         if s < 1 else frame)
                rgb = cv2.cvtColor(small, cv2.COLOR_BGR2RGB)
                res = be.detect(rgb, full=None if s >= 1
                                else cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
                if res.ok:
                    try:
                        feat, diag = features.extract(res.landmarks,
                                                      rgb.shape[1], rgb.shape[0])
                        if tracker is not None:
                            # The mapper reads columns 10/11, so a frame with
                            # no tag has no head signal and must be SKIPPED,
                            # not padded. Padding would feed the model a
                            # confident zero and swing the cursor.
                            hit = tracker.find(cv2.cvtColor(frame,
                                                            cv2.COLOR_BGR2GRAY))
                            if hit is None:
                                raise ValueError("tag lost")
                            fh, fw = frame.shape[:2]
                            extra = [hit[0][0] / float(fw),
                                     hit[0][1] / float(fh), 0.0, 0.0, 0.0]
                            if intr is not None and tracker.last_corners is not None:
                                pose = tagtrack.pose_from_corners(
                                    tracker.last_corners, intr.K,
                                    intr.dist_coeffs)
                                if pose is None:
                                    raise ValueError("no tag pose")
                                extra[2], extra[3], extra[4] = (pose[0], pose[1],
                                                                pose[3])
                            feat = np.concatenate([feat, extra])
                        if not features.is_blinking(
                                diag, cfg["inference"]["blink_ear_threshold"]):
                            px, py = mapper.predict(feat)
                            gx, gy = filt(float(px), float(py), now)
                    except Exception:
                        pass
        if use_mouse or gx is None:
            gx, gy = mouse["x"], mouse["y"]
        last_gx, last_gy = gx, gy

        gx = min(max(float(gx), 0.0), W - 1.0)
        gy = min(max(float(gy), 0.0), H - 1.0)
        cell = cell_at(gx, gy, m, W, H)

        # HYSTERESIS. On a 6-cell board, jitter inside a cell is cosmetic and
        # jitter across a boundary is fatal: the highlight flickers between two
        # cells and the user cannot tell which one a keypress will speak.
        #
        # So a new cell has to win `hold` consecutive samples before the hover
        # moves. At ~16 Hz that is ~190 ms at the default of 3 -- long enough
        # to swallow the noise, short enough that a deliberate look feels
        # immediate. Crucially the committed cell STAYS put while the raw point
        # wanders, which is what makes the board feel solid.
        #
        # This is not extra smoothing. Smoothing trades lag for jitter
        # everywhere; hysteresis spends it only at the boundary, which is the
        # only place it matters here.
        if cell == cand:
            cand_n += 1
        else:
            cand, cand_n = cell, 1
        if cell != hover and cand_n >= max(1, args.hold):
            hover = cell
            dwell_since = now if (press is not None and args.dwell > 0) else None
        frac = 0.0
        if head and not use_mouse and not tag_seen:
            # Tag lost: freeze the dwell too, not just the pointer. The
            # pointer is held on its last cell, so letting the clock run
            # would speak that cell a second or two after the tag went --
            # a word nobody asked for, which on an AAC board is the whole
            # failure.
            dwell_since = now
        elif args.dwell > 0 and dwell_since is not None and press is not None:
            frac = (now - dwell_since) / args.dwell

        # What is highlighted is what gets spoken. Anything else is a lie to the
        # user, and on an AAC device saying the wrong word is the whole failure.
        press = m.at(*hover) if hover else None

        if use_mouse:
            src = "mouse"
        elif head:
            src = "head" if tag_seen else "head TAG LOST"
        elif eyepose:
            src = "eyepose"
        elif eyetag:
            src = "eyetag"
        else:
            src = "gaze"
        status = ("%s   click/dwell speak   RIGHT-CLICK home   b back"
                  "   r recalibrate   m %s   q quit   [hold %d  smooth %.2f]"
                  % (src, "gaze" if use_mouse else "mouse", args.hold, args.smooth))
        draw_board(canvas, m, hover, W, H, status, frac)
        if at_home:
            draw_exit_chip(canvas, W, H, now < exit_armed_until,
                           in_exit(mouse["x"], mouse["y"], W, H))
        if trail is not None:
            trail.append((gx, gy))
            draw_trail(canvas, trail)     # under the cursor, never over it
        cv2.circle(canvas, (int(gx), int(gy)), 16, (255, 255, 255), 2)
        cv2.circle(canvas, (int(gx), int(gy)), 3, ACCENT, -1)

        if args.record:
            if args.record_every and now - last_auto >= args.record_every:
                want_shot["now"] = True
                last_auto = now
            if want_shot["now"]:
                want_shot["now"] = False
                shot_n += 1
                fn = os.path.join(args.record, "talker_%03d.png" % shot_n)
                cv2.imwrite(fn, canvas)
                if args.record_cam and last_frame is not None:
                    # Same instant, same index: the pair shows the face and
                    # the screen that face was looking at. Saved RAW -- any
                    # de-identifying happens later, deliberately, rather than
                    # being half-done here where it would be easy to assume
                    # it had been handled.
                    cv2.imwrite(os.path.join(args.record,
                                             "cam_%03d.png" % shot_n),
                                last_frame)
                # Log the STATE beside the filename, not just the name. A
                # capture run makes dozens of frames and the one worth
                # keeping is picked by what the board was doing -- mid-dwell
                # with the bar part-filled, or a steady hold -- which no
                # amount of staring at thumbnails recovers afterwards.
                sx = sy = 0.0
                if trail and len(trail) > 4:
                    xs = [p[0] for p in trail]
                    ys = [p[1] for p in trail]
                    sx, sy = max(xs) - min(xs), max(ys) - min(ys)
                print("saved %s  src=%s hover=%s dwell=%.2f spread=%.0fx%.0fpx"
                      % (os.path.basename(fn), src, hover, frac, sx, sy),
                      flush=True)

        cv2.imshow(WIN, canvas)
        k = cv2.waitKey(1) & 0xFF

        # Home is checked BEFORE `fire` is latched. Below the latch the
        # click has already been folded into `fire` and clearing it does
        # nothing -- the cell under the cursor speaks on the way out.
        if want_recenter["now"]:
            want_recenter["now"] = False
            if headmap is not None and headmap.fitted and last_tag is not None:
                headmap.recenter(last_tag)
                print("head map recentred on the current tag position")

        if mouse["home"]:
            mouse["home"] = False
            mouse["click"] = False       # navigation never also speaks
            dwell_since = now            # and never lands mid-dwell either
            if (m, menu_dir) != home:
                m, menu_dir = home
                del stack[:]
                hover, cand, cand_n = None, None, 0
            continue

        clicked = mouse["click"]
        mouse["click"] = False
        fire = k in (32, 13, 10) or clicked or (frac >= 1.0)

        # The chip takes a LEFT-CLICK and never a dwell. Two independent
        # guards, because an exit that fires by accident mid-demo is worse
        # than one that takes a second click: the corner is out of gaze
        # reach, and gaze cannot press it even if a visitor gets there.
        # It sits above the grid, so `press` is already None here and the
        # ordinary fire path would silently do nothing with the click.
        if at_home and clicked and in_exit(mouse["x"], mouse["y"], W, H):
            if now < exit_armed_until:
                break
            exit_armed_until = now + EXIT_ARM_S
            continue
        if clicked:
            exit_armed_until = 0.0       # a press anywhere else disarms

        if k == ord('q'):
            break
        if k == ord('m'):
            # Only a real toggle when there is something to toggle to.
            if mapper is None:
                print("no gaze model fitted; staying on the pointer")
            else:
                use_mouse = not use_mouse
            continue
        if k == ord('b'):
            nxt = back_target(m, menu_dir, stack)
            if nxt is not None:
                m, menu_dir = nxt
                hover, dwell_since = None, None
            continue
        if k == ord('r') and cam is not None and head:
            nm, why, _ = calibrate_head(cam, canvas, tracker, args.headcal,
                                        W, H, args.tag_id)
            if nm is not None:
                headmap, use_mouse = nm, False
                if hasattr(filt, "reset"):
                    filt.reset()
            else:
                print("head recalibration failed: %s" % why)
            continue
        if k == ord('r') and cam is not None:
            Model = (calib.TagPoseMapper if eyepose else
                     calib.TagAssistedMapper if eyetag else calib.LinearMapper)
            nm = calibrate(cam, be, cfg, canvas, args.points, rng,
                           tracker=tracker, intr=intr, Model=Model)
            if nm is not None:
                mapper, use_mouse = nm, False
                if hasattr(filt, "reset"):
                    filt.reset()
            continue

        if fire and press is not None:
            cx, cy = cell_centre(hover[0], hover[1], m, W, H)
            log.append((press.label, gx - cx, gy - cy, src))
            dwell_since = now
            if press.is_back:
                nxt = back_target(m, menu_dir, stack)
                if nxt is not None:
                    m, menu_dir = nxt
                    hover = None
            elif press.is_submenu:
                path = menulib.resolve(press.submenu, menu_dir)
                if path and os.path.exists(path):
                    stack.append((m, menu_dir))
                    m = menulib.load(path)
                    menu_dir = os.path.dirname(os.path.abspath(path))
                    hover = None
                else:
                    print("submenu not found: %s" % path)
            else:
                voice.say(press)

    voice.stop()
    if cam is not None:
        cam.close()
    if be is not None:
        be.close()
    cv2.destroyAllWindows()

    if log:
        d = np.array([[a, b] for _, a, b, _ in log], dtype=float)
        r = np.hypot(d[:, 0], d[:, 1])
        mmx = cfg["screen"]["width_mm"] / float(W)
        D = cfg["screen"]["viewing_distance_mm"]
        deg = np.degrees(np.arctan(r * mmx / D))
        print("\n%d selections" % len(log))
        print("  offset from cell centre: p50 %.0f px (%.2f deg)  p95 %.0f px (%.2f deg)"
              % (np.percentile(r, 50), np.percentile(deg, 50),
                 np.percentile(r, 95), np.percentile(deg, 95)))
        print("  worst %.0f px (%.2f deg)" % (r.max(), deg.max()))
        # A cell is 640x540 px; half of that is the margin before a miss.
        half = min(W / m.columns, (H - 160) / m.rows) / 2.0
        print("  margin to the cell edge: %.0f px. %d of %d landed in the outer "
              "third of their cell." % (half, int((r > half * 2 / 3.0).sum()), len(r)))
        for lab in sorted({l for l, _, _, _ in log}):
            n = sum(1 for l, _, _, _ in log if l == lab)
            print("    %-22s %d" % (lab, n))


if __name__ == "__main__":
    main()
